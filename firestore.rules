rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 7 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'balance', 'accountNumber', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 9 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.type in ['checking', 'savings', 'credit'] &&
             data.balance is number &&
             data.accountNumber is string && data.accountNumber.size() <= 50 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'accountId', 'type', 'amount', 'timestamp', 'status', 'description']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.accountId is string &&
             data.type in ['deposit', 'withdrawal', 'transfer_in', 'transfer_out'] &&
             data.amount is number && data.amount > 0 &&
             data.status in ['completed', 'pending', 'failed'] &&
             data.timestamp == request.time;
    }

    // Rules for Users
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt', 'photoURL']) &&
                    incoming().updatedAt == request.time;
    }

    // Rules for Accounts
    match /accounts/{accountId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidAccount(incoming()) && isValidId(accountId);
      allow update: if isSignedIn() && isOwner(existing().userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'name', 'updatedAt']) &&
                    incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Rules for Transactions
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTransaction(incoming()) && 
                    isValidId(transactionId) &&
                    get(/databases/$(database)/documents/accounts/$(incoming().accountId)).data.userId == request.auth.uid;
      // Transactions are usually immutable
      allow update: if false; 
      allow delete: if false;
    }
  }
}
